<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 1. PERMISSIONS REQUIRED FOR FOREGROUND SERVICES -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- We use SPECIAL_USE as a timer doesn't fit standard media/location categories perfectly -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        WorkManager (used for background sync) asks for RECEIVE_BOOT_COMPLETED to restart its schedule after a reboot.
        Until the release that ships sync, release builds must not gain new permissions, so it is removed here.
        Remove these two lines when sync ships (background syncs then also resume after a reboot without opening the app).
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <!-- The same for the network state permission that WorkManager and the Wi-Fi-only rule need. The debug build declares it itself. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:name=".TimenoteApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Timenote">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. DECLARE OUR FOREGROUND SERVICE -->
        <service
            android:name="com.oblutack.timenote.TimerForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Premium Productivity Timer" />
        </service>

    </application>

</manifest>