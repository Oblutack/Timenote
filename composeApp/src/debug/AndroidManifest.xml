<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Network access is declared for DEBUG builds only while cloud sync is being built.
        Release builds stay without it (the app is fully offline today); it moves to the main
        manifest in the release that actually ships sync.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

</manifest>
